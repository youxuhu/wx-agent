# machine-local / heavy data — never sync
sessions/
npm/
web-search-cache/
missions/
bin/
node_modules/
# machine-local state / secrets — copy manually or re-login, never commit
auth.json*
*.bak*
computer-use.json
models-store.json
models.json
run-history.jsonl
sandbox.json
trust.json
package.json
package-lock.json
pi-subagents/
# the desktop/ui remembers the last folder here (machine state, not config)
piwebui-workspaces.json
# extension scratch state only — extension sources stay tracked
extensions/runs/
extensions/*/node_modules/
extensions/piwebui/desktop/resources/
extensions/piwebui/desktop/src-tauri/target/
extensions/piwebui/desktop/src-tauri/gen/
# secrets / machine-local state discovered after this file was written
web-search.json
checkpoints.json
policy-audit.log
pi-web-access/

# private undo state and validation evidence
checkpoint-v2/
verification/

outputs/

handoffs/

maintenance-candidates.json

maintenance-lock.json

backups/

__pycache__/

/pi-lsp.json

# 语言服务的版本 pin 必须入库（其它位置的 package*.json 仍是运行产物）
!lsp/package.json
!lsp/package-lock.json
logs/

# Standalone assistant dependencies are pinned; install tree stays local.
!assistants/inner/package.json
!assistants/inner/package-lock.json
