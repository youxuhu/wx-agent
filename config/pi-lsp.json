{
  "typescript": {
    "command": [
      "typescript-language-server",
      "--stdio"
    ],
    "extensions": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".mts",
      ".cts",
      ".mjs",
      ".cjs"
    ]
  },
  "pyright": {
    "command": [
      "pyright-langserver",
      "--stdio"
    ],
    "extensions": [
      ".py",
      ".pyi"
    ]
  }
}
