{
  "enabled": false,
  "unsandboxedCommands": [
    "screencapture"
  ],
  "network": {
    "allowedDomains": [
      "open.bigmodel.cn",
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "registry.npmjs.org",
      "*.npmjs.org",
      "pypi.org",
      "*.pypi.org"
    ],
    "deniedDomains": [],
    "allowLocalBinding": true,
    "allowMachLookup": [
      "com.apple.mDNSResponder",
      "com.apple.dnssd",
      "com.apple.system.opendirectoryd.libinfo"
    ]
  },
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.aws",
      "~/.gnupg"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "/private/tmp",
      "/private/var/folders",
      "~/.pi",
      "~/Library/Caches",
      "~/.npm"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  }
}
