{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "pi agent",
	"version": "0.1.0",
	"identifier": "dev.pi.agent",
	"build": {
		"frontendDist": "../web"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"label": "main",
				"title": "pi agent",
				"url": "index.html",
				"width": 1280,
				"height": 860,
				"minWidth": 720,
				"minHeight": 480
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg"],
		"icon": ["icons/icon.png"],
		"resources": {
			"../resources/node": "node",
			"../resources/server.mjs": "server.mjs",
			"../resources/node_modules": "node_modules",
			"../resources/dist": "dist",
			"../resources/pi": "pi"
		},
		"macOS": {
			"exceptionDomain": "127.0.0.1",
			"minimumSystemVersion": "12.0"
		}
	}
}
